{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Platform & Release Overview",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Total Deployments",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(deployhub_deployments_total) or vector(0)",
          "legendFormat": "Total"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "id": 2,
      "title": "Successful Releases",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [
        {
          "expr": "sum(deployhub_deployments_success_total) or vector(0)",
          "legendFormat": "Success"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "green", "mode": "fixed" } }
      }
    },
    {
      "id": 3,
      "title": "Deployment Success Rate",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [
        {
          "expr": "(sum(deployhub_deployments_success_total) / (sum(deployhub_deployments_total) > 0) * 100) or vector(100)",
          "legendFormat": "Rate %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "green", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Active Deployments",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sum(deployhub_active_deployments) or vector(0)",
          "legendFormat": "In Progress"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "blue", "mode": "fixed" } }
      }
    },
    {
      "id": 5,
      "title": "Running Containers",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "targets": [
        {
          "expr": "deployhub_running_containers or vector(0)",
          "legendFormat": "Containers"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "purple", "mode": "fixed" } }
      }
    },
    {
      "id": 6,
      "title": "One-Click Rollbacks",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "targets": [
        {
          "expr": "sum(deployhub_rollbacks_total) or vector(0)",
          "legendFormat": "Rollbacks"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "orange", "mode": "fixed" } }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Traffic Switching & Container Health",
      "type": "row"
    },
    {
      "id": 7,
      "title": "Traffic Switches (Zero-Downtime)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum by (result) (rate(deployhub_traffic_switches_total[5m]))",
          "legendFormat": "Switches ({{result}})"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops/s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } }
      }
    },
    {
      "id": 8,
      "title": "Automatic Container Restarts",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 6 },
      "targets": [
        {
          "expr": "sum by (result) (rate(deployhub_container_restarts_total[5m]))",
          "legendFormat": "Restarts ({{result}})"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops/s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } }
      }
    },
    {
      "id": 9,
      "title": "Traffic Switch Failures",
      "type": "stat",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 6 },
      "targets": [
        {
          "expr": "sum(deployhub_traffic_switches_total{result=\"failed\"}) or vector(0)",
          "legendFormat": "Failed Switches"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "red", "mode": "fixed" } }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 102,
      "title": "Resource Telemetry (CPU & Memory)",
      "type": "row"
    },
    {
      "id": 10,
      "title": "Container CPU Usage (%)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "deployhub_container_cpu_usage",
          "legendFormat": "{{project_id}} - {{container_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } }
      }
    },
    {
      "id": 11,
      "title": "Container Memory Usage (Bytes)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "deployhub_container_memory_usage_bytes",
          "legendFormat": "{{project_id}} (Usage)"
        },
        {
          "expr": "deployhub_container_memory_limit_bytes",
          "legendFormat": "{{project_id}} (Limit)"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "id": 103,
      "title": "Deployment Performance & Latency",
      "type": "row"
    },
    {
      "id": 12,
      "title": "Deployment Latency Duration",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "rate(deployhub_deployment_duration_seconds_sum[5m]) / rate(deployhub_deployment_duration_seconds_count[5m])",
          "legendFormat": "Avg Duration (s)"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } }
      }
    },
    {
      "id": 13,
      "title": "Deployment Failures by Reason",
      "type": "piechart",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 22 },
      "targets": [
        {
          "expr": "sum by (reason) (deployhub_deployment_failures_by_reason)",
          "legendFormat": "{{reason}}"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["deployhub", "milestone4", "observability"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "",
  "title": "DeployHub Observability Overview",
  "uid": "deployhub-overview",
  "version": 2
}
